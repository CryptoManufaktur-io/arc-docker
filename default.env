# The settings are in .env, use "nano .env". Don't edit default.env itself.
#
# Arc Mainnet RPC node - Docker Compose
# Arc is a purpose-built Layer-1 blockchain with USDC as gas,
# sub-second deterministic finality, and full EVM compatibility.
#
# Images are hosted on Cloudsmith; docker login to docker.cloudsmith.io is required.
# Upstream RPC URLs and Cloudsmith credentials are provided by Chainlink Labs via 1Password.

# -----------------------------------------------------------------------
# COMPOSE_FILE
# -----------------------------------------------------------------------
# Minimal (no exposed ports):
#   COMPOSE_FILE=arc.yml
#
# With locally exposed RPC ports:
#   COMPOSE_FILE=arc.yml:rpc-shared.yml
#
# With traefik / central-proxy-docker:
#   COMPOSE_FILE=arc.yml:rpc-shared.yml:ext-network.yml
COMPOSE_FILE=arc.yml
PROJECT_NAME=arc

# -----------------------------------------------------------------------
# ARC NODE IMAGES
# -----------------------------------------------------------------------
# Check https://github.com/circlefin/arc-node/releases for the latest version.
# NOTE: Arc Mainnet uses private images on Cloudsmith (credentials from Chainlink Labs).
ARC_VERSION=0.7.2
ARC_EXECUTION_IMAGE=docker.cloudsmith.io/circle/arc-network/arc-execution:0.7.2
ARC_CONSENSUS_IMAGE=docker.cloudsmith.io/circle/arc-network/arc-consensus:0.7.2

# -----------------------------------------------------------------------
# SNAPSHOT URLS
# -----------------------------------------------------------------------
# The mainnet snapshot index is private. Contact Chainlink Labs for a newer snapshot URL.
EXECUTION_SNAPSHOT_URL=https://snapshots-private.arc.network/api/download/mainnet/snapshot-arc-mainnet-pruned-execution-20260604T1605Z-3432788.tar.lz4
CONSENSUS_SNAPSHOT_URL=https://snapshots-private.arc.network/api/download/mainnet/snapshot-arc-mainnet-pruned-consensus-20260604T1605Z-3432788.tar.lz4

# -----------------------------------------------------------------------
# UPSTREAM RPC ENDPOINTS
# -----------------------------------------------------------------------
# Arc Mainnet is in a private phase and requires trusted upstream providers.
# Shared in 1Password

EL_UPSTREAM_RPC=

CL_UPSTREAM_ENDPOINT_1=
CL_UPSTREAM_ENDPOINT_2=
CL_UPSTREAM_ENDPOINT_3=

# -----------------------------------------------------------------------
# PORTS
# -----------------------------------------------------------------------
EL_RPC_PORT=8545
EL_WS_PORT=8546
EL_METRICS_PORT=9001
CL_RPC_PORT=31000
CL_METRICS_PORT=29000

# -----------------------------------------------------------------------
# EXTRAS
# -----------------------------------------------------------------------
EL_EXTRAS=
CL_EXTRAS=

# -----------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------
# Traefik / secure web proxy
# -----------------------------------------------------------------------
DOMAIN=example.com
RPC_HOST=arc
RPC_LB=arc-lb
WS_HOST=arcws
WS_LB=arcws-lb

SHARE_IP=

# External Docker network name
DOCKER_EXT_NETWORK=traefik_default

# Pin arcd/ethd script to a specific git tag (leave blank for latest)
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=1
