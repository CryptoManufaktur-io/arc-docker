# The settings are in .env, use "nano .env". Don't edit default.env itself.
#
# Arc Mainnet RPC node - Docker Compose
# Arc is a purpose-built Layer-1 blockchain with USDC as gas,
# sub-second deterministic finality, and full EVM compatibility.
#
# Images are hosted on Cloudsmith; docker login to docker.cloudsmith.io is required.
# Upstream RPC URLs and Cloudsmith credentials are provided by Chainlink Labs via 1Password.

# -----------------------------------------------------------------------
# COMPOSE_FILE
# -----------------------------------------------------------------------
# Minimal (no exposed ports):
#   COMPOSE_FILE=arc.yml
#
# With locally exposed RPC ports:
#   COMPOSE_FILE=arc.yml:rpc-shared.yml
#
# With traefik / central-proxy-docker:
#   COMPOSE_FILE=arc.yml:rpc-shared.yml:ext-network.yml
COMPOSE_FILE=arc.yml
PROJECT_NAME=arc

# -----------------------------------------------------------------------
# ARC NODE IMAGES
# -----------------------------------------------------------------------
# Check https://github.com/circlefin/arc-node/releases for the latest version.
# NOTE: Arc Mainnet uses private images on Cloudsmith (credentials from Chainlink Labs).
ARC_VERSION=0.8.0
ARC_EXECUTION_IMAGE=docker.cloudsmith.io/circle/arc-network/arc-execution:0.8.0
ARC_CONSENSUS_IMAGE=docker.cloudsmith.io/circle/arc-network/arc-consensus:0.8.0

# -----------------------------------------------------------------------
# SNAPSHOT URLS
# -----------------------------------------------------------------------
# The mainnet snapshot index is private. Contact Chainlink Labs for a newer snapshot URL.
# Only needed for the first bootstrap: when EXECUTION_SNAPSHOT_URL is empty, arc-snapshots and
# arc-init are skipped and execution/consensus start from the existing data. Clear both URLs once
# the node has synced (snapshot links expire, and an expired link blocks `up`).
COMPOSE_PROFILES=snapshot
EXECUTION_SNAPSHOT_URL=
CONSENSUS_SNAPSHOT_URL=

# -----------------------------------------------------------------------
# UPSTREAM RPC ENDPOINTS
# -----------------------------------------------------------------------
# Arc Mainnet is public; these are the official endpoints from
# https://docs.arc.io/arc/tutorials/run-an-arc-node. Nodes run in follow mode with discovery
# disabled, so EL_UPSTREAM_RPC is the only path transactions take to the network.

EL_UPSTREAM_RPC=https://rpc.mainnet.arc.io/

CL_UPSTREAM_ENDPOINT_1=https://rpc.mainnet.arc.io,wss=rpc.mainnet.arc.io
CL_UPSTREAM_ENDPOINT_2=https://rpc.drpc.mainnet.arc.io,wss=rpc.drpc.mainnet.arc.io
CL_UPSTREAM_ENDPOINT_3=https://rpc.blockdaemon.mainnet.arc.io,wss=rpc.blockdaemon.mainnet.arc.io/websocket

# -----------------------------------------------------------------------
# PORTS
# -----------------------------------------------------------------------
EL_RPC_PORT=8545
EL_WS_PORT=8546
EL_METRICS_PORT=9001
CL_RPC_PORT=31000
CL_METRICS_PORT=29000

# -----------------------------------------------------------------------
# EXTRAS
# -----------------------------------------------------------------------
EL_EXTRAS=
CL_EXTRAS=

# -----------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------
# Traefik / secure web proxy
# -----------------------------------------------------------------------
DOMAIN=example.com
RPC_HOST=arc
RPC_LB=arc-lb
WS_HOST=arcws
WS_LB=arcws-lb

SHARE_IP=

# External Docker network name
DOCKER_EXT_NETWORK=traefik_default

# Pin arcd/ethd script to a specific git tag (leave blank for latest)
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=1
